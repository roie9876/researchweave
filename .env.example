# ResearchWeave Environment Configuration Template
# Never commit real API keys, connection strings, or tenant secrets to Git.

PORT=8080
RESEARCHWEAVE_DATA_DIR=./.researchweave_data

# Optional Azure Managed Identity & Per-Run Blob Storage (uses DefaultAzureCredential)
AZURE_CLIENT_ID=
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net

# Optional Azure AI Foundry / OpenAI Model Pool & Content Understanding Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com/
MODEL_POOL_DEFAULT=gpt-6.1-sol,gpt-6-astra
